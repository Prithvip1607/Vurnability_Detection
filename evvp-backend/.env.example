# Copy to .env (never commit .env). Every value is optional: EVVP runs with none of them set.
# Leave a value EMPTY rather than putting a placeholder in it — placeholders are sent as real credentials.

# ── API credentials (all optional) ────────────────────────────────────────────
# https://github.com/settings/tokens (public_repo). Strongly recommended: unauthenticated GitHub search is ~10 req/min
GITHUB_TOKEN=
# https://nvd.nist.gov/developers/request-an-api-key  (raises the NVD rate limit ~10x)
NVD_API_KEY=
# optional AI summaries; extractive summaries are used when empty
OPENAI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=EVVP/2.0

# ── Server ────────────────────────────────────────────────────────────────────
# use 0.0.0.0 only behind a firewall / reverse proxy (Docker sets this itself)
EVVP_HOST=127.0.0.1
EVVP_PORT=8000
# if set, every write (add/edit/delete source, analyst decisions) needs "Authorization: Bearer <token>"
EVVP_API_TOKEN=
# only needed for the optional React dev server
EVVP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# seconds the API caches the correlated view when data changes in another process
EVVP_CACHE_TTL=30

# ── Storage ───────────────────────────────────────────────────────────────────
# Empty = JSONL files under raw_data/ (no setup). For PostgreSQL:
# DB_URL=postgresql://evvp:evvp@localhost:5432/evvp
# EVVP_RAW_DATA_DIR=./raw_data
# EVVP_DATA_DIR=./data
# EVVP_LOG_DIR=./logs

# ── Source safety ─────────────────────────────────────────────────────────────
# Analyst-supplied source URLs may not point at private/loopback addresses (SSRF protection).
# Set to 1 ONLY for local testing against a feed on localhost.
# EVVP_ALLOW_PRIVATE_SOURCES=1

# ── Notifications (optional) ──────────────────────────────────────────────────
# WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_EMAIL_TO=security-team@yourcompany.com
# ALERT_EMAIL_FROM=evvp@yourcompany.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_MIN_SCORE=14
# NOTIFY_SEVERITY_FILTER=CRITICAL,HIGH

# ── CVE trend alerts ──────────────────────────────────────────────────────────
# SPIKE_WINDOW_HOURS=6
# SPIKE_THRESHOLD=3
# TREND_COOLDOWN_MINS=60

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# EVVP_KEV_LOOKBACK_DAYS=14     CISA KEV collector: ingest entries added within this many days
# EVVP_TICK_SECONDS=30           how often collectors check which sources are due
# GITHUB_REQUESTS_PER_HOUR=1500  GitHub search request budget (default 120 without a token)
# NVD_BASE_URL / EPSS_URL / KEV_URL / GITHUB_API_URL / REDDIT_BASE_URL   override endpoints (used by the offline simulator)
