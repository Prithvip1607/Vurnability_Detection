# ── Credentials ───────────────────────────────────────────────────────────────
# Reddit — https://www.reddit.com/prefs/apps (optional, public JSON works without)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=EVVP/1.0

# GitHub — https://github.com/settings/tokens (read:public_repo, read:org)
GITHUB_TOKEN=your_github_token

# NVD — https://nvd.nist.gov/developers/request-an-api-key (optional, removes rate limits)
NVD_API_KEY=your_nvd_api_key

# OpenAI — https://platform.openai.com/api-keys (for AI-generated vulnerability summaries)
# If not set, system will use fallback text extraction
OPENAI_API_KEY=your_openai_api_key

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave empty to use JSONL file storage (no setup needed)
# DB_URL=postgresql://user:password@localhost:5432/evvp

# ── Polling intervals (seconds) ───────────────────────────────────────────────
# REDDIT_POLL_INTERVAL=300
# GITHUB_POLL_INTERVAL=600
# BLOG_POLL_INTERVAL=900
# NVD_POLL_INTERVAL=3600

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack or Discord incoming webhook URL
# WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email alerts
# ALERT_EMAIL_TO=security-team@yourcompany.com
# ALERT_EMAIL_FROM=evvp@yourcompany.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Only notify for items with score >= this (default: 14)
# NOTIFY_MIN_SCORE=14

# Only notify for these severities (default: CRITICAL,HIGH)
# NOTIFY_SEVERITY_FILTER=CRITICAL,HIGH

# ── CVE Trend Tracker ─────────────────────────────────────────────────────────
# Fire trending alert when a CVE gets N mentions within SPIKE_WINDOW_HOURS
# SPIKE_WINDOW_HOURS=6
# SPIKE_THRESHOLD=3
# TREND_COOLDOWN_MINS=60
